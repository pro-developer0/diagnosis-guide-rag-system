# API key for the service that writes answers. Free Groq keys: https://console.groq.com
# Never commit the real value.
LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Chat model name. Groq retires models over time:
# https://console.groq.com/docs/models
LLM_MODEL=openai/gpt-oss-120b

# Optional. Any OpenAI-compatible chat completions URL, for example a service
# your organization has approved for clinical data. Defaults to Groq.
# LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
